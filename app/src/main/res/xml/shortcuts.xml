<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: open the Debian terminal directly (MainActivity reads the "screen" extra). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="terminal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_terminal"
        android:shortcutShortLabel="@string/shortcut_terminal"
        android:shortcutLongLabel="@string/shortcut_terminal_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.ccmobile"
            android:targetClass="app.ccmobile.MainActivity">
            <extra android:name="screen" android:value="terminal" />
        </intent>
    </shortcut>
</shortcuts>
